{
  "name": "uhs",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@uhs/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml --profile infra up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --profile infra down",
    "infra:logs": "docker compose -f infra/docker-compose.yml --profile infra logs -f",
    "infra:ps": "docker compose -f infra/docker-compose.yml --profile infra ps",
    "stack:up": "docker compose -f infra/docker-compose.local.yml up --build -d",
    "stack:down": "docker compose -f infra/docker-compose.local.yml down",
    "stack:logs": "docker compose -f infra/docker-compose.local.yml logs -f",
    "stack:ps": "docker compose -f infra/docker-compose.local.yml ps",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
