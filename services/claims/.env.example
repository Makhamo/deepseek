# claims service. Copy to .env before running.
# Shared values (RABBITMQ_URL, AUTH_*) live in the repository .env.
SERVICE_NAME=claims
PORT=4008
DATABASE_URL=postgresql://uhs_app:uhs_app@localhost:5432/uhs_claims
MIGRATION_DATABASE_URL=postgresql://uhs_migrator:uhs_migrator@localhost:5432/uhs_claims
