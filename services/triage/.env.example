# triage service. Copy to .env before running.
# Shared values (RABBITMQ_URL, AUTH_*) live in the repository .env.
SERVICE_NAME=triage
PORT=4004
DATABASE_URL=postgresql://uhs_app:uhs_app@localhost:5432/uhs_triage
MIGRATION_DATABASE_URL=postgresql://uhs_migrator:uhs_migrator@localhost:5432/uhs_triage
