# ---------------------------------------------------------------------------
# UHS local development. Copy to .env and adjust. Never commit the real .env.
#
# This file holds values shared by every service. Each service has its own
# .env.example with DATABASE_URL / MIGRATION_DATABASE_URL, because every
# service owns a separate database (spec section 2).
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# Shared infrastructure (see: npm run infra:up)
RABBITMQ_URL=amqp://uhs:uhs@localhost:5672
REDIS_URL=redis://localhost:6379
OTEL_EXPORTER_OTLP_ENDPOINT=

# auth owns accounts, memberships, roles and the JWKS every other service
# verifies tokens against.
AUTH_JWKS_URL=http://localhost:4001/api/auth/jwks
AUTH_ISSUER=http://localhost:4001
AUTH_JWT_ALG=EdDSA
AUTH_AUDIENCE=uhs-api
AUTH_SECRET=replace-me-with-a-long-random-value

# Browser origin allowed to call the services through the web BFF.
CORS_ORIGINS=http://localhost:3000

# apps/web (server side only; service addresses never reach the browser)
AUTH_SERVICE_URL=http://localhost:4001
CORE_SERVICE_URL=http://localhost:4002
DOCTOR_SERVICE_URL=http://localhost:4003
TRIAGE_SERVICE_URL=http://localhost:4004
LAB_SERVICE_URL=http://localhost:4005
NICU_SERVICE_URL=http://localhost:4006
PHARMACY_SERVICE_URL=http://localhost:4007
CLAIMS_SERVICE_URL=http://localhost:4008
NOTIFICATIONS_SERVICE_URL=http://localhost:4009
