# Staging. Copy to .env.staging on the VPS and fill in real values.
# Never commit the filled-in file.

UHS_ENV=staging
COMPOSE_PROJECT_NAME=uhs-staging

# Host port for the web app. Staging and production publish different ports so
# both stacks can run on one VPS.
WEB_HOST_PORT=3100

# Images are built by CI and pushed to GHCR.
UHS_IMAGE_PREFIX=ghcr.io/your-github-user/uhs
IMAGE_TAG=latest

POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
POSTGRES_APP_PASSWORD=change-me-app
POSTGRES_MIGRATOR_PASSWORD=change-me-migrator
RABBITMQ_USER=uhs
RABBITMQ_PASSWORD=change-me-rabbitmq

# Public origin of the staging site. Issuer must match the token auth issues.
AUTH_ISSUER=https://staging.example.com
AUTH_JWT_ALG=EdDSA
BETTER_AUTH_SECRET=change-me-long-random-value
CORS_ORIGINS=https://staging.example.com

LOG_LEVEL=info
