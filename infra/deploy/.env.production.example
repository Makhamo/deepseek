# Production. Copy to .env.production on the VPS and fill in real values.
# Never commit the filled-in file.

UHS_ENV=production
COMPOSE_PROJECT_NAME=uhs-production

# Host port for the web app. Staging uses 3100; production keeps 3000.
WEB_HOST_PORT=3000

UHS_IMAGE_PREFIX=ghcr.io/your-github-user/uhs
IMAGE_TAG=latest

POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
POSTGRES_APP_PASSWORD=change-me-app
POSTGRES_MIGRATOR_PASSWORD=change-me-migrator
RABBITMQ_USER=uhs
RABBITMQ_PASSWORD=change-me-rabbitmq

AUTH_ISSUER=https://app.example.com
AUTH_JWT_ALG=EdDSA
BETTER_AUTH_SECRET=change-me-long-random-value
CORS_ORIGINS=https://app.example.com

LOG_LEVEL=info
